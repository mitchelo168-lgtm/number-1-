# Copy this file to .env and fill in whichever integrations you're using.
# Every field is optional at startup - the API/GUI run fine with nothing set,
# and each integration just reports itself as "not configured" until its
# fields are filled in (see GET /api/settings/credential-status).

# --- Twitch ---------------------------------------------------------------
# Create an app at https://dev.twitch.tv/console/apps (free). Used for the
# Helix "get streams" live-check and app-access-token flow.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# --- YouTube ----------------------------------------------------------------
# YouTube Data API v3 key from https://console.cloud.google.com (free tier:
# 10,000 quota units/day; each live-status poll costs ~100 units via
# search.list, so polling many channels every couple of minutes will burn
# through quota fast - start with a small streamer list).
YOUTUBE_API_KEY=

# --- Kick -------------------------------------------------------------------
# Kick's public API (https://api.kick.com/public/v1, OAuth client-credentials).
# Register an app via Kick's developer settings. Kick's API is newer and less
# stable than Twitch/YouTube's - see streamclip/platforms/kick.py for notes on
# what may need re-verifying against current docs.
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=

# --- Discord ------------------------------------------------------------
# A bot token from https://discord.com/developers/applications (bot needs
# "Send Messages", "Attach Files", and message-content/interaction intents),
# plus the numeric ID of the channel it should post live/clip notifications
# and approve/reject buttons into.
DISCORD_BOT_TOKEN=
DISCORD_REVIEW_CHANNEL_ID=

# --- Post for Me (https://postforme.dev) -------------------------------
# Unified social posting API (~$10/mo for ~1000 posts across many connected
# accounts). Create an API key in its dashboard, then connect your social
# accounts there - streamclip publishes approved clips through it.
POST_FOR_ME_API_KEY=

# --- Tuning (safe to leave at defaults) -------------------------------------
HIGHLIGHT_PRE_ROLL_SECONDS=40
HIGHLIGHT_POST_ROLL_SECONDS=10
CHAT_RATE_ZSCORE_THRESHOLD=2.5
AUDIO_EVENT_CONFIDENCE_THRESHOLD=0.6
POLL_INTERVAL_SECONDS=120
CHUNK_DURATION_SECONDS=600

# --- GUI build-time (used only by `docker compose build gui`) ---------------
# This gets baked into the GUI's JavaScript at build time and is evaluated in
# EVERY VISITOR'S OWN BROWSER - "localhost" only works if you're browsing from
# the same machine the server runs on. For any real deployment, set this to
# your server's actual public IP or domain, e.g.:
#   VITE_API_BASE_URL=http://203.0.113.5:8000
#   VITE_API_BASE_URL=https://clips.example.com
VITE_API_BASE_URL=http://localhost:8000
